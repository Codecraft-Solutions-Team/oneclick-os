#!/usr/bin/bash
# Does the real work for the Update page in Settings.
#   check <full|security>      prints STAGED, AVAILABLE or NONE
#   download <full|security>   downloads the newest build for that choice, queued for next restart
#   version <X.Y>              downloads that version (it then receives security fixes only)
#   rollback                   queues the build this PC ran before the last update
#   versions                   lists published versions, newest first (no administrator rights needed)
# "full" follows the newest version. "security" stays on this PC's version, which is rebuilt
# with security fixes but gets no new features.
set -o pipefail

IMAGE=$(cat /usr/share/oneclick/image)
VERSION=$(cat /usr/share/oneclick/version)

tag_for() { [[ "$1" == "security" ]] && echo "${VERSION}" || echo "latest"; }
status() {
    bootc status --json 2>/dev/null | python3 -c "import sys,json
try:
    s=json.load(sys.stdin).get('status') or {}
except Exception:
    s={}
$1"
}
booted_ref()    { status "print((((s.get('booted') or {}).get('image') or {}).get('image') or {}).get('image', ''))"; }
booted_digest() { status "print(((s.get('booted') or {}).get('image') or {}).get('imageDigest', ''))"; }
has_staged()    { status "print('yes' if s.get('staged') else '')"; }
remember() { mkdir -p /var/lib/oneclick && echo "$1" > /var/lib/oneclick/channel; }
get() {  # get <tag>: upgrade in place if already following that tag, otherwise switch to it
    if [[ "$(booted_ref)" == "${IMAGE}:$1" ]]; then bootc upgrade; else bootc switch "${IMAGE}:$1"; fi
}
print_skopeo_error() {
    local err="$1" fallback="$2"
    if grep -qiE '401|403|unauthorized|denied' <<< "$err"; then
        echo "Updates cannot be reached yet (package access is private)." >&2
    elif [[ -n "$err" ]]; then
        echo "${err##*$'\n'}" >&2
    elif [[ -n "$fallback" ]]; then
        echo "$fallback" >&2
    fi
}

case "${1:-}" in
    check)
        if [[ -n "$(has_staged)" ]]; then echo STAGED; exit 0; fi
        tag=$(tag_for "${2:-full}")
        err_file=$(mktemp)
        if ! remote=$(skopeo inspect --no-tags --format '{{.Digest}}' "docker://${IMAGE}:${tag}" 2>"$err_file"); then
            err=$(<"$err_file")
            rm -f "$err_file"
            print_skopeo_error "$err" "Could not check for updates."
            exit 1
        fi
        rm -f "$err_file"
        local_digest="$(booted_digest)"
        if [[ -n "${remote}" && "${remote}" == "${local_digest}" ]]; then echo NONE; else echo AVAILABLE; fi ;;
    download)
        get "$(tag_for "${2:-full}")" && remember "${2:-full}" ;;
    version)
        [[ "${2:-}" =~ ^[0-9]+\.[0-9]+$ ]] || { echo "not a version: ${2:-}" >&2; exit 2; }
        get "$2" && remember security ;;
    rollback)
        bootc rollback ;;
    versions)
        err_file=$(mktemp)
        if ! tags_json=$(skopeo list-tags "docker://${IMAGE}" 2>"$err_file"); then
            err=$(<"$err_file")
            rm -f "$err_file"
            print_skopeo_error "$err" ""
            exit 1
        fi
        rm -f "$err_file"
        python3 -c '
import sys, json, re
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
tags = [t for t in (data.get("Tags") or []) if isinstance(t, str) and re.fullmatch(r"\d+\.\d+", t)]
if tags:
    print("\n".join(sorted(tags, key=lambda t: [int(p) for p in t.split(".")], reverse=True)))' <<< "$tags_json" ;;
    *)
        echo "usage: $0 check|download|version|rollback|versions" >&2; exit 2 ;;
esac
