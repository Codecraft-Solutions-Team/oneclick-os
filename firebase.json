{
  "hosting": [
    {
      "site": "oneclick-os",
      "public": "website",
      "cleanUrls": true,
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(css|js|woff2|svg|png|jpg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/report",
          "function": {
            "functionId": "oneclickReport",
            "region": "us-central1"
          }
        }
      ]
    },
    {
      "site": "oneclick-support",
      "public": "support/public",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(css|js|woff2|svg|png|jpg|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/report",
          "function": {
            "functionId": "oneclickReport",
            "region": "us-central1"
          }
        }
      ]
    },
    {
      "site": "oneclick-dash",
      "public": "dash/public",
      "cleanUrls": true,
      "ignore": [
        "**/.*"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "oneclick",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}